name: "ganoam:dv:stream_reg_sim:0.1"
description: "STREAM_REG DV sim target"
filesets:
  files_rtl:
    depend:
      - ganoam:ip:stream_reg

  files_dv:
    depend:
      - ganoam:dv:stream_reg_test
      - ganoam:dv:stream_reg_sva
      - ganoam:dv:uvm_pkg
    files:
      - tb.sv
    file_type: systemVerilogSource

targets:
  sim: &sim_target
    toplevel: tb
    filesets:
      - files_rtl
      - files_dv
    default_tool: verilator

    tools:
      verilator:
        mode: binary
        verilator_options:
          - "-Wno-fatal"
          - "--timing"
          - "-j 16"
          - "+define+UVM"
          - "--trace-fst"
          - "--trace-structs"
          - "--vpi"


  # TODO: add a lint check cfg in `hw/top_earlgrey/lint/top_earlgrey_dv_lint_cfgs.hjson`
  lint:
    <<: *sim_target
